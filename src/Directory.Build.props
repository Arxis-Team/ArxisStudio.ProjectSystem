<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    MSBuild stops at the first Directory.Build.props it finds walking up, so the root one is
    imported explicitly above.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!--
    Kept although nothing is published: a project referencing these libraries reads the XML file for
    IntelliSense, so the documentation is for whoever writes against them rather than for a package
    listing. An architecture test also reads it to check every diagnostic code is documented.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
