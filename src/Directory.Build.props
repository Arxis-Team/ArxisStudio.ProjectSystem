<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    MSBuild stops at the first Directory.Build.props it finds walking up, so the root one is
    imported explicitly above. Everything below is what makes this directory the shipping one.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>project-system;solution;csproj;sln;msbuild;dotnet</PackageTags>
  </PropertyGroup>

  <!--
    Where the source of a package came from, and how to get back to it. RepositoryUrl and
    RepositoryCommit are what Source Link writes into the symbols, so a consumer stepping into
    this package lands in the commit it was built from rather than in decompiled IL.

    Source Link needs no PackageReference: the .NET SDK carries the GitHub provider and turns it
    on for a repository that has a git directory and an origin remote. What it does need is a
    build that is deterministic and knows its own remote, which is the rest of this file and the
    root props.
  -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/Arxis-Team/ArxisStudio.ProjectSystem</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Arxis-Team/ArxisStudio.ProjectSystem.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EnableSourceLink>true</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Public API surface tracking. New public API must be declared in PublicAPI.Unshipped.txt or
    the build fails. Enabled from milestone 0 while the surface is still empty, so no
    retrospective inventory is ever needed.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
