<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ArxisStudio.ProjectSystem.Markup.Xaml.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ArxisStudio.ProjectSystem.Markup.Xaml/ArxisStudio.ProjectSystem.Markup.Xaml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!--
    The fixtures: a project's own controls, built before these tests and never referenced as an
    assembly. Their output and their documents are copied beside the tests under fixtures/, and a test
    copies them into a project folder of its own, where a generation loads them into a collectible
    context as it loads a user's build. In the default context they could never be reclaimed.
  -->
  <PropertyGroup>
    <DesignFixturesProject>../ArxisStudio.ProjectSystem.Markup.Xaml.Fixtures/ArxisStudio.ProjectSystem.Markup.Xaml.Fixtures.csproj</DesignFixturesProject>
  </PropertyGroup>

  <!--
    And a package's: a library mapping a XAML namespace of its own, copied under fixtures/package/ and
    named by a test's snapshot as a restored package's runtime asset.
  -->
  <PropertyGroup>
    <PackageFixturesProject>../ArxisStudio.ProjectSystem.Markup.Xaml.PackageFixtures/ArxisStudio.ProjectSystem.Markup.Xaml.PackageFixtures.csproj</PackageFixturesProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(DesignFixturesProject)" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(PackageFixturesProject)" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyDesignFixtures" AfterTargets="Build">
    <MSBuild Projects="$(DesignFixturesProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="DesignFixtureAssembly" />
    </MSBuild>

    <MSBuild Projects="$(PackageFixturesProject)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="PackageFixtureAssembly" />
    </MSBuild>

    <ItemGroup>
      <DesignFixtureDocument Include="../ArxisStudio.ProjectSystem.Markup.Xaml.Fixtures/*.axaml" />
    </ItemGroup>

    <Copy SourceFiles="@(DesignFixtureAssembly);@(DesignFixtureDocument)" DestinationFolder="$(OutDir)fixtures" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(PackageFixtureAssembly)" DestinationFolder="$(OutDir)fixtures/package" SkipUnchangedFiles="true" />
  </Target>

</Project>
