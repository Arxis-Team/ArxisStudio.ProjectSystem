<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FormsDesigner.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <!--
      The colour picker's own theme, which FluentTheme does not carry: the controls live in a package
      of their own and so do their templates. Without this a ColorView is a control with no template
      — it measures 70×15, draws nothing, and the flyout opens on an empty rectangle.

      Here rather than on the window, because the flyout it appears in is a platform popup: a window
      of its own, whose styles come from the application and not from the window that opened it.
    -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

    <!-- And the XAML pane's editor, for the same reason: its template ships with it. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <StyleInclude Source="avares://FormsDesigner/Views/Styles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>

        <!-- The design's own tokens, and they come first so the editor's theme below can be
             overridden by them where the two describe the same thing. -->
        <ResourceInclude Source="avares://FormsDesigner/Views/Theme.axaml" />

        <!--
          The editor's own theme, and without it there is no editor. DesignEditor ships its
          template, its grid, its selection adorners and its resources in one dictionary that an
          application merges; a control with no template renders nothing at all, so the canvas was
          an empty rectangle — no grid, no forms, no handles — while every log line said the
          document had loaded perfectly. It had. There was simply nothing drawing it.
        -->
        <ResourceInclude Source="avares://ArxisStudio.DesignEditor/Themes/ArxisStudioDesignEditorTheme.axaml" />

      </ResourceDictionary.MergedDictionaries>

      <!-- Forms are outlined at rest: on a dark canvas there is otherwise nothing to say where one
           form ends and the next begins. -->
      <x:Double x:Key="DesignEditorItem.OutlineOpacity">0.75</x:Double>

    </ResourceDictionary>
  </Application.Resources>

</Application>
