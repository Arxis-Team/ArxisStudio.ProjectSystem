<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The design's control styles. Sizes, radii and weights are the mockup's numbers rather than
    approximations of them: a 28px control among 26px controls is the difference between a window
    that looks designed and one that looks assembled.

    Every rule here is either qualified by a class this designer puts on its own controls, or scoped
    under `.chrome` — the class its panels, bars and splitters carry. Neither reaches the canvas.

    That scoping is not tidiness. A style cascades to everything below it in the tree, and the form
    being edited is below this window like everything else, so a bare `TextBlock` rule set the font
    of every label in somebody else's document and a bare `TextBox` rule gave their fields this
    tool's background. The designer then showed a form that did not look like the form. Avalonia
    offers no way to stop a style at a subtree — `IStyleHost.StylingParent` cuts the styles and the
    control themes with them, which leaves the form invisible rather than unstyled — so the rule is
    kept where it can be kept: a selector that cannot match anything outside this window's chrome.

    The cost is that overlays are outside it. A combo box's drop-down and a tool tip live in the
    window's overlay layer rather than under the panel that opened them, so they fall back to the
    theme's own look. That is a smaller wrong than restyling the document.
  -->

  <Style Selector=".chrome TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <!-- A section label: uppercase, tracked out, quiet. -->
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <Style Selector="TextBlock.panelTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- A toolbar button: flat until it is pointed at. -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <Style Selector="Button.tool:disabled /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Fg3}" />
  </Style>

  <!-- The accented one, for the single action a screen is about. -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource Acc}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAcc}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccH}" />
  </Style>

  <!-- An icon square in the toolbar. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
  </Style>

  <!-- The close button turns red under the pointer, as every window's does. -->
  <Style Selector="Button.closeButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Red}" />
  </Style>

  <Style Selector=".chrome TextBox">
    <Setter Property="Background" Value="{DynamicResource Inp}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brd2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Fg}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector=".chrome TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Acc}" />
  </Style>

  <Style Selector=".chrome ComboBox">
    <Setter Property="Background" Value="{DynamicResource Inp}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brd2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector=".chrome CheckBox">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Panels: one border colour, one radius, nothing else. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brd}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.panelHeader">
    <Setter Property="Height" Value="34" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brd}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,0,8,0" />
  </Style>

  <!-- A file in the project grid. Flat until pointed at, because it answers a double click. -->
  <Style Selector="Border.tile:pointerover">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>

  <!-- One value of an enum, in the row of them the design draws for a small type. -->
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="{DynamicResource Inp}" />
    <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brd2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,3,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.segment:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>

  <Style Selector="Button.segment.chosen /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Acc}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAcc}" />
  </Style>

  <Style Selector=".chrome ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector=".chrome ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector=".chrome ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Sel}" />
  </Style>

  <Style Selector=".chrome ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
  </Style>

  <Style Selector=".chrome TreeViewItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector=".chrome TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Sel}" />
  </Style>

  <Style Selector="GridSplitter.chrome">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
