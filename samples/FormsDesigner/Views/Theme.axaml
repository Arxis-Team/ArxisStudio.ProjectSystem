<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The design's tokens, verbatim. Both variants are here because the mockup ships both and the
    toggle in the toolbar is one of the things it shows; Avalonia picks between them by
    ThemeVariant, so nothing in the window has to know which is current.
  -->
  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Bg1" Color="#1E1F22" />
      <SolidColorBrush x:Key="Bg2" Color="#2B2D30" />
      <SolidColorBrush x:Key="Bg3" Color="#393B40" />
      <SolidColorBrush x:Key="Bg4" Color="#43454A" />
      <SolidColorBrush x:Key="Brd" Color="#393B40" />
      <SolidColorBrush x:Key="Brd2" Color="#4E5157" />
      <SolidColorBrush x:Key="Fg" Color="#DFE1E5" />
      <SolidColorBrush x:Key="Fg2" Color="#9DA0A8" />
      <SolidColorBrush x:Key="Fg3" Color="#6F737A" />
      <SolidColorBrush x:Key="Acc" Color="#3574F0" />
      <SolidColorBrush x:Key="AccH" Color="#4682FA" />
      <SolidColorBrush x:Key="OnAcc" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Sel" Color="#2E436E" />
      <SolidColorBrush x:Key="Canvas" Color="#191A1D" />
      <SolidColorBrush x:Key="Inp" Color="#1E1F22" />
      <SolidColorBrush x:Key="Grn" Color="#5FAD65" />
      <SolidColorBrush x:Key="Red" Color="#E55765" />
      <SolidColorBrush x:Key="Yel" Color="#D6AE58" />
      <SolidColorBrush x:Key="Org" Color="#E08855" />
      <SolidColorBrush x:Key="Pur" Color="#9A7CF7" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Bg1" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Bg2" Color="#F7F8FA" />
      <SolidColorBrush x:Key="Bg3" Color="#EBECF0" />
      <SolidColorBrush x:Key="Bg4" Color="#DFE1E5" />
      <SolidColorBrush x:Key="Brd" Color="#EBECF0" />
      <SolidColorBrush x:Key="Brd2" Color="#C9CCD6" />
      <SolidColorBrush x:Key="Fg" Color="#27282E" />
      <SolidColorBrush x:Key="Fg2" Color="#6C707E" />
      <SolidColorBrush x:Key="Fg3" Color="#A8ADBD" />
      <SolidColorBrush x:Key="Acc" Color="#3574F0" />
      <SolidColorBrush x:Key="AccH" Color="#2E5FD3" />
      <SolidColorBrush x:Key="OnAcc" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Sel" Color="#D4E2FF" />
      <SolidColorBrush x:Key="Canvas" Color="#EDEEF1" />
      <SolidColorBrush x:Key="Inp" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Grn" Color="#1E8934" />
      <SolidColorBrush x:Key="Red" Color="#CC3B49" />
      <SolidColorBrush x:Key="Yel" Color="#9E6C00" />
      <SolidColorBrush x:Key="Org" Color="#BD5B15" />
      <SolidColorBrush x:Key="Pur" Color="#6F4FD9" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!--
    The editor's own palette, keyed the way DesignEditor's theme expects, so the canvas and the
    grid belong to the same design as everything around them rather than to the library's defaults.
  -->
  <SolidColorBrush x:Key="DesignEditor.Grid.BackgroundBrush" Color="#191A1D" />
  <SolidColorBrush x:Key="DesignEditor.Grid.LineBrush" Color="#26292E" />
  <SolidColorBrush x:Key="DesignEditor.Grid.MajorLineBrush" Color="#33353A" />
  <x:Double x:Key="DesignEditor.Grid.CellSize">20</x:Double>
  <x:Int32 x:Key="DesignEditor.Grid.MajorInterval">5</x:Int32>

  <FontFamily x:Key="UiFont">Inter,Segoe UI,system-ui,sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">JetBrains Mono,Cascadia Code,Consolas,monospace</FontFamily>

</ResourceDictionary>
