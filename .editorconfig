root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Matches what the tooling actually writes, so no editor "tidies" the solution into a diff.
[*.sln]
end_of_line = crlf
indent_style = tab

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion
csharp_style_prefer_readonly_struct = true:suggestion

# Public API must be documented.
dotnet_diagnostic.CS1591.severity = warning

# Public API surface tracking.
dotnet_diagnostic.RS0016.severity = error
dotnet_diagnostic.RS0017.severity = error
dotnet_diagnostic.RS0037.severity = none

[src/**/*.cs]
# "The core has no UI-thread affinity and must not capture a synchronization context
# accidentally." That is a property of every await in the shipping assembly, so it is
# enforced by the compiler rather than by review. CA2007 is not in the recommended set
# by default; it is switched on here deliberately and only for shipping code.
dotnet_diagnostic.CA2007.severity = error

[tests/**/*.cs]
# Public API documentation is required of the shipping package only.
dotnet_diagnostic.CS1591.severity = none
# Method_Scenario_Expectation is the intended test naming convention.
dotnet_diagnostic.CA1707.severity = none
# Concrete-type-for-performance rules are noise in test helpers.
dotnet_diagnostic.CA1859.severity = none
