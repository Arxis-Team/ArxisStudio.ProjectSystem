<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Quality gates. The task specification requires warnings to be treated as errors. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    Carry the configuration into project references.

    MSBuild decides a reference's configuration from the configuration table of the solution being
    built, and defaults to *unsetting* it for any project that table does not mention.
    ArxisStudio.Markup lives in another repository and is never in this solution, so a Release build
    linked Debug assemblies of it.

    Repository-wide rather than on the adapter alone, because MSBuild flattens transitive references
    for ordering: the tests and the sample build ArxisStudio.Markup directly and each unsets the
    configuration for itself. The same setting exists in that repository, where the references below
    the entry point lose it in turn; both halves are needed and neither is sufficient.

    The property name says "AndPlatform", and it means it: the platform is forwarded as well, to
    every reference rather than only to the cross-repository one. That is worth stating because the
    solution spells the platform "Any CPU" and a project spells it "AnyCPU", and a forwarded
    mismatch would move a reference's output directory. It does not happen here, and the reason is
    measurable rather than assumed: a project built through the solution already holds the mapped
    "AnyCPU", so that is the value the children inherit. Every project of both repositories resolves
    Platform='AnyCPU' and OutDir='bin\$(Configuration)\net10.0\'. It would stop being true if a
    project here declared Platforms of its own; none does, and one that did would need this read
    again.
  -->
  <PropertyGroup>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <!-- Reproducible builds. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    These libraries are referenced directly, not published. Saying so here rather than nowhere stops
    a stray `dotnet pack` producing packages nobody meant to exist.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>ArxisStudio</Authors>
    <Company>ArxisStudio</Company>
    <Product>ArxisStudio.ProjectSystem</Product>
    <Copyright>Copyright (c) ArxisStudio</Copyright>
  </PropertyGroup>

</Project>
